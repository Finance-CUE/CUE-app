# CUE backend environment.
# Copy to .env and fill in real values. NEVER commit .env.

APP_ENV=development

# Supabase project settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Secret key bypasses RLS. Server-side only. Never ship to a client.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Comma-separated. Only needed for Expo web; native apps send no Origin.
CORS_ORIGINS=http://localhost:8081
