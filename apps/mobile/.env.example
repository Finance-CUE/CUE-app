# Mobile app environment. Copy to .env and set your values.
#
# This is the ONLY backend detail the app is allowed to know. Supabase URLs and
# keys must never appear here - anything in an EXPO_PUBLIC_ variable is embedded
# in the app bundle and readable by anyone who downloads the APK.
#
# Dev on a physical device: use your machine's LAN IP, not localhost.
#   Windows: ipconfig   |   macOS/Linux: ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1

# Google sign-in: the OAuth "Web application" client ID from Google Cloud
# (the same one entered in Supabase > Auth > Providers > Google). Public, not a
# secret. Leave empty to hide nothing but make the Google button explain it's off.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
